# Copy to .env if you need to override defaults. Do not commit .env.

OPD_API_HOST=127.0.0.1
OPD_API_PORT=8000
# JSON list. pydantic-settings parses this form.
OPD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Fictional demo accounts (nurse.demo, doctor.demo, admin.demo) are created when the
# users table is empty. Leave OPD_DEMO_PASSWORD empty to generate a random password,
# which is written to OPD_DEMO_CREDENTIALS_PATH (git-ignored), never to the log.
OPD_SEED_USERS=true
OPD_DEMO_PASSWORD=
OPD_DEMO_CREDENTIALS_PATH=data/demo_credentials.txt
OPD_SESSION_HOURS=12

# Clinic offset from UTC in minutes. 330 is India Standard Time. Used for "today" counts.
OPD_CLINIC_UTC_OFFSET_MINUTES=330

# Seed labelled illustrative cases on startup.
OPD_SEED_DEMO=false

# Local folder after credentialed PhysioNet access. Leave empty when the files are absent.
# https://physionet.org/content/mimic-iv-ed/
OPD_MIMIC_ED_DIR=

# Frontend (also read from frontend/.env.development during Vite dev).
VITE_API_BASE_URL=http://127.0.0.1:8000
